{
  "name": "Tag",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "title": "Church ID"
    },
    "name": {
      "type": "string",
      "title": "Tag Name"
    },
    "folder_id": {
      "type": "string",
      "title": "Folder ID"
    },
    "color": {
      "type": "string",
      "title": "Color",
      "default": "#6366f1"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "leader_person_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Tag Leader Person IDs",
      "default": []
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}