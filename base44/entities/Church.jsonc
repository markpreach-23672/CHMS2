{
  "name": "Church",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Church Name"
    },
    "subdomain": {
      "type": "string",
      "title": "Subdomain"
    },
    "site_url": {
      "type": "string",
      "title": "Public Site URL",
      "description": "The full public URL of your church app (e.g. https://easy-church-flow.base44.app)"
    },
    "custom_domain": {
      "type": "string",
      "title": "Custom Web Link",
      "description": "Optional custom domain / web link for this church"
    },
    "monthly_rate": {
      "type": "number",
      "title": "Monthly Rate ($)",
      "default": 0
    },
    "logo_url": {
      "type": "string",
      "title": "Logo URL"
    },
    "timezone": {
      "type": "string",
      "title": "Timezone",
      "default": "America/New_York"
    },
    "branding_color": {
      "type": "string",
      "title": "Branding Color",
      "default": "#4f46e5"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "city": {
      "type": "string",
      "title": "City"
    },
    "state": {
      "type": "string",
      "title": "State"
    },
    "zip": {
      "type": "string",
      "title": "ZIP"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "resend_from_email": {
      "type": "string",
      "title": "Resend From Email"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "active",
        "trial",
        "suspended",
        "cancelled"
      ],
      "default": "trial"
    },
    "subscription_started_date": {
      "type": "string",
      "format": "date"
    },
    "guest_report_tag_id": {
      "type": "string",
      "title": "Weekly Guest Report Tag ID"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "read": true,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "church_admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}