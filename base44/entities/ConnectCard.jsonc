{
  "name": "ConnectCard",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "title": "Church ID"
    },
    "name": {
      "type": "string",
      "title": "Card Name"
    },
    "title": {
      "type": "string",
      "title": "Display Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "title": "Field Key"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "email",
              "tel",
              "textarea",
              "select",
              "date",
              "checkbox"
            ],
            "title": "Field Type"
          },
          "required": {
            "type": "boolean",
            "title": "Required"
          },
          "maps_to": {
            "type": "string",
            "title": "Maps To"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "Options"
          }
        }
      },
      "title": "Form Fields",
      "default": []
    },
    "workflow_id": {
      "type": "string",
      "title": "Workflow ID"
    },
    "keyword": {
      "type": "string",
      "title": "Text Keyword"
    },
    "tag_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Tag IDs",
      "default": []
    },
    "button_text": {
      "type": "string",
      "title": "Submit Button Text",
      "default": "Submit"
    },
    "confirmation_message": {
      "type": "string",
      "title": "Confirmation Message"
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    }
  },
  "required": [
    "name"
  ]
}