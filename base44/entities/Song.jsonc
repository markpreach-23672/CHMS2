{
  "name": "Song",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "title": "Church ID"
    },
    "title": {
      "type": "string",
      "title": "Song Title"
    },
    "artist": {
      "type": "string",
      "title": "Artist / Author"
    },
    "default_key": {
      "type": "string",
      "title": "Default Key"
    },
    "bpm": {
      "type": "number",
      "title": "BPM"
    },
    "ccli_number": {
      "type": "string",
      "title": "CCLI Song Number"
    },
    "song_url": {
      "type": "string",
      "title": "Song Link (YouTube/Spotify)"
    },
    "lyrics_url": {
      "type": "string",
      "title": "Lyrics Link (override)"
    },
    "score_url": {
      "type": "string",
      "title": "Sheet Music / Chord Chart Link (override)"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}