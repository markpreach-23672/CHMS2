{
  "name": "ServiceType",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "title": "Church ID"
    },
    "name": {
      "type": "string",
      "title": "Service Type Name"
    },
    "default_time": {
      "type": "string",
      "title": "Default Start Time",
      "default": "10:00"
    },
    "positions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Positions",
      "default": [
        "Worship Leader",
        "Vocals",
        "Keys",
        "Guitar",
        "Bass",
        "Drums",
        "Usher",
        "Greeter",
        "Emcee",
        "Prayer",
        "Announcements",
        "Sound",
        "Media"
      ]
    },
    "default_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "type": {
            "type": "string",
            "enum": [
              "header",
              "element",
              "song"
            ],
            "title": "Type",
            "default": "element"
          },
          "duration_minutes": {
            "type": "number",
            "title": "Duration (min)",
            "default": 5
          }
        }
      },
      "title": "Default Order of Service",
      "default": []
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}