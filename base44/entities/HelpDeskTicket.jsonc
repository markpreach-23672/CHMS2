{
  "name": "HelpDeskTicket",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "title": "Church ID"
    },
    "question": {
      "type": "string",
      "title": "Question"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "asked_by_user_id": {
      "type": "string",
      "title": "Asked By User ID"
    },
    "asked_by_name": {
      "type": "string",
      "title": "Asked By"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolved"
      ],
      "default": "open",
      "title": "Status"
    },
    "staff_response": {
      "type": "string",
      "title": "Staff Response"
    },
    "resolved_by_user_id": {
      "type": "string",
      "title": "Resolved By User ID"
    }
  },
  "required": [
    "question"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}