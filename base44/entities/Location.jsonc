{
  "name": "Location",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "title": "Church ID"
    },
    "name": {
      "type": "string",
      "title": "Location Name"
    },
    "type": {
      "type": "string",
      "enum": [
        "site",
        "room"
      ],
      "default": "room",
      "title": "Type"
    },
    "parent_id": {
      "type": "string",
      "title": "Parent Site ID"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "city": {
      "type": "string",
      "title": "City"
    },
    "state": {
      "type": "string",
      "title": "State"
    },
    "zip": {
      "type": "string",
      "title": "ZIP"
    },
    "capacity": {
      "type": "number",
      "title": "Capacity"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "name",
    "type"
  ]
}