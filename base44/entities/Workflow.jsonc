{
  "name": "Workflow",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "title": "Church ID"
    },
    "name": {
      "type": "string",
      "title": "Workflow Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "trigger_connect_card_id": {
      "type": "string",
      "title": "Trigger Connect Card ID"
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "connect_card",
        "tag",
        "calendar_date",
        "person_date"
      ],
      "default": "connect_card",
      "title": "Trigger Type"
    },
    "trigger_tag_id": {
      "type": "string",
      "title": "Trigger Tag ID"
    },
    "trigger_calendar_id": {
      "type": "string",
      "title": "Trigger Calendar ID"
    },
    "trigger_person_date_field": {
      "type": "string",
      "enum": [
        "birth_date",
        "first_visit_date",
        "baptism_date",
        "membership_date"
      ],
      "title": "Trigger Person Date Field"
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.church_id": "{{user.data.church_id}}"
            },
            {
              "user_condition": {
                "role": "church_admin"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.church_id": "{{user.data.church_id}}"
            },
            {
              "user_condition": {
                "role": "church_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.church_id": "{{user.data.church_id}}"
            },
            {
              "user_condition": {
                "role": "church_admin"
              }
            }
          ]
        }
      ]
    }
  }
}