{
  "name": "TextMessageLog",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "title": "Church ID"
    },
    "to": {
      "type": "string",
      "title": "Recipient Number"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "failed"
      ],
      "title": "Status",
      "default": "sent"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "title": "Sent At"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}