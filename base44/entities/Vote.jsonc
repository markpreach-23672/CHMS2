{
  "name": "Vote",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "title": "Church ID"
    },
    "election_id": {
      "type": "string",
      "title": "Election ID"
    },
    "person_id": {
      "type": "string",
      "title": "Person ID"
    },
    "voter_email": {
      "type": "string",
      "title": "Voter Email"
    },
    "voter_name": {
      "type": "string",
      "title": "Voter Name"
    },
    "candidate": {
      "type": "string",
      "title": "Candidate"
    },
    "voted_at": {
      "type": "string",
      "format": "date-time",
      "title": "Voted At"
    }
  },
  "required": [
    "election_id",
    "candidate",
    "voter_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}