{
  "name": "Pledge",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "title": "Church ID"
    },
    "person_id": {
      "type": "string",
      "title": "Person ID"
    },
    "fund_id": {
      "type": "string",
      "title": "Fund ID"
    },
    "total_amount": {
      "type": "number",
      "title": "Total Pledged"
    },
    "amount_given": {
      "type": "number",
      "title": "Amount Given",
      "default": 0
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "Start Date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "End Date"
    }
  },
  "required": [
    "total_amount",
    "start_date"
  ]
}