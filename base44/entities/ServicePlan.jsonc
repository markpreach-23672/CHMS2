{
  "name": "ServicePlan",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "title": "Church ID"
    },
    "service_type_id": {
      "type": "string",
      "title": "Service Type ID"
    },
    "title": {
      "type": "string",
      "title": "Plan Title"
    },
    "service_date": {
      "type": "string",
      "format": "date",
      "title": "Service Date"
    },
    "service_time": {
      "type": "string",
      "title": "Start Time",
      "default": "10:00"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "completed"
      ],
      "title": "Status",
      "default": "draft"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "email_sent_at": {
      "type": "string",
      "format": "date-time",
      "title": "Team Email Sent At"
    },
    "google_event_id": {
      "type": "string",
      "title": "Google Calendar Event ID"
    }
  },
  "required": [
    "title",
    "service_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}