{
  "name": "PlanAssignment",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "title": "Church ID"
    },
    "plan_id": {
      "type": "string",
      "title": "Service Plan ID"
    },
    "person_id": {
      "type": "string",
      "title": "Person ID"
    },
    "position": {
      "type": "string",
      "title": "Position"
    },
    "team_id": {
      "type": "string",
      "title": "Team ID (if from a team)"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "confirmed",
        "declined"
      ],
      "title": "Status",
      "default": "scheduled"
    }
  },
  "required": [
    "plan_id",
    "person_id",
    "position"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}