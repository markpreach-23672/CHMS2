{
  "name": "Election",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "title": "Church ID"
    },
    "title": {
      "type": "string",
      "title": "Election Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Candidates",
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "open",
        "closed"
      ],
      "default": "draft",
      "title": "Status"
    },
    "open_date": {
      "type": "string",
      "format": "date-time",
      "title": "Open Date"
    },
    "close_date": {
      "type": "string",
      "format": "date-time",
      "title": "Close Date"
    },
    "max_votes_per_person": {
      "type": "number",
      "default": 1,
      "title": "Max Votes Per Person"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "title": "Public"
    }
  },
  "required": [
    "title",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}