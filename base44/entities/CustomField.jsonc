{
  "name": "CustomField",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "title": "Church ID"
    },
    "name": {
      "type": "string",
      "title": "Field Name"
    },
    "field_type": {
      "type": "string",
      "enum": [
        "text",
        "number",
        "date",
        "dropdown",
        "checkbox",
        "file"
      ],
      "title": "Field Type"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Dropdown Options",
      "default": []
    },
    "applies_to": {
      "type": "string",
      "enum": [
        "person",
        "family"
      ],
      "title": "Applies To",
      "default": "person"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "name",
    "field_type",
    "applies_to"
  ]
}