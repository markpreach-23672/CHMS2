{
  "name": "CustomField",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "title": "Church ID"
    },
    "name": {
      "type": "string",
      "title": "Field Name"
    },
    "field_type": {
      "type": "string",
      "enum": [
        "text",
        "number",
        "date",
        "dropdown",
        "multi_select",
        "checkbox",
        "phone",
        "email",
        "file"
      ],
      "title": "Field Type"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Dropdown Options",
      "default": []
    },
    "applies_to": {
      "type": "string",
      "enum": [
        "person",
        "family"
      ],
      "title": "Applies To",
      "default": "person"
    },
    "section": {
      "type": "string",
      "title": "Section",
      "default": ""
    },
    "is_private": {
      "type": "boolean",
      "title": "Private (Admin Only)",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "name",
    "field_type",
    "applies_to"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}