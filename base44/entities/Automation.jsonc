{
  "name": "Automation",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "title": "Church ID"
    },
    "name": {
      "type": "string",
      "title": "Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "birthday",
        "anniversary",
        "form_submission",
        "monthly_digest"
      ],
      "title": "Trigger Type",
      "default": "birthday"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "everyone",
        "tag",
        "saved_search"
      ],
      "title": "Target Type",
      "default": "everyone"
    },
    "target_tag_id": {
      "type": "string",
      "title": "Target Tag ID"
    },
    "target_saved_search_id": {
      "type": "string",
      "title": "Target Saved Search ID"
    },
    "trigger_form_id": {
      "type": "string",
      "title": "Trigger Form ID"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "send_email",
        "send_text",
        "apply_tag"
      ],
      "title": "Action Type",
      "default": "send_email"
    },
    "action_tag_id": {
      "type": "string",
      "title": "Action Tag ID"
    },
    "subject": {
      "type": "string",
      "title": "Email Subject"
    },
    "body": {
      "type": "string",
      "title": "Message Body"
    },
    "from_number": {
      "type": "string",
      "title": "From Number (SMS)"
    },
    "offset_days": {
      "type": "number",
      "title": "Offset Days",
      "default": 0
    },
    "day_of_month": {
      "type": "number",
      "title": "Day of Month",
      "default": 28
    },
    "notify_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Notify User IDs",
      "default": []
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    }
  },
  "required": [
    "name",
    "trigger_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.church_id": "{{user.data.church_id}}"
            },
            {
              "user_condition": {
                "role": "church_admin"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.church_id": "{{user.data.church_id}}"
            },
            {
              "user_condition": {
                "role": "church_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "data.church_id": "{{user.data.church_id}}"
            },
            {
              "user_condition": {
                "role": "church_admin"
              }
            }
          ]
        }
      ]
    }
  }
}