{
  "name": "CalendarEvent",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "title": "Church ID"
    },
    "calendar_id": {
      "type": "string",
      "title": "Calendar ID"
    },
    "title": {
      "type": "string",
      "title": "Event Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time",
      "title": "End Time"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "all_day": {
      "type": "boolean",
      "title": "All Day",
      "default": false
    },
    "tag_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Tag IDs",
      "default": []
    },
    "is_recurring": {
      "type": "boolean",
      "title": "Recurring",
      "default": false
    },
    "recurrence_frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "monthly"
      ],
      "title": "Recurrence Frequency"
    },
    "recurrence_interval": {
      "type": "number",
      "title": "Recurrence Interval",
      "default": 1
    },
    "recurrence_days": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "title": "Recurrence Days (0-6)"
    },
    "recurrence_week": {
      "type": "number",
      "title": "Recurrence Week (1-4 or -1 for last)"
    },
    "recurrence_weekday": {
      "type": "number",
      "title": "Recurrence Weekday (0-6)"
    },
    "recurrence_end_date": {
      "type": "string",
      "format": "date",
      "title": "Recurrence End Date"
    },
    "external_event_id": {
      "type": "string",
      "title": "External Calendar Event ID"
    },
    "sync_provider": {
      "type": "string",
      "enum": [
        "google",
        "outlook"
      ],
      "title": "Sync Provider"
    }
  },
  "required": [
    "title",
    "start_time"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}