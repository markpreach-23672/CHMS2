{
  "name": "AttendanceRecord",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "title": "Church ID"
    },
    "event_id": {
      "type": "string",
      "title": "Calendar Event ID"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "title": "Event Date"
    },
    "person_id": {
      "type": "string",
      "title": "Person ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "present",
        "absent"
      ],
      "title": "Status",
      "default": "present"
    }
  },
  "required": [
    "event_id",
    "person_id",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}