{
  "name": "NotificationSetting",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "title": "Church ID"
    },
    "reminders_enabled": {
      "type": "boolean",
      "title": "Service Reminders Enabled",
      "default": true
    },
    "reminder_days_before": {
      "type": "number",
      "title": "Days Before Service",
      "default": 3
    },
    "reminder_time": {
      "type": "string",
      "title": "Send Time (HH:00)",
      "default": "09:00"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}