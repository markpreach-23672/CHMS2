{
  "name": "PlanItem",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "title": "Church ID"
    },
    "plan_id": {
      "type": "string",
      "title": "Service Plan ID"
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    },
    "type": {
      "type": "string",
      "enum": [
        "header",
        "element",
        "song"
      ],
      "title": "Item Type",
      "default": "element"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "duration_minutes": {
      "type": "number",
      "title": "Duration (min)",
      "default": 5
    },
    "song_id": {
      "type": "string",
      "title": "Song ID"
    },
    "key_override": {
      "type": "string",
      "title": "Key (override)"
    },
    "person_id": {
      "type": "string",
      "title": "Led By (Person ID)"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "plan_id",
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}