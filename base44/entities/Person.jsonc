{
  "name": "Person",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "title": "Church ID"
    },
    "first_name": {
      "type": "string",
      "title": "First Name"
    },
    "last_name": {
      "type": "string",
      "title": "Last Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "mobile": {
      "type": "string",
      "title": "Mobile"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "city": {
      "type": "string",
      "title": "City"
    },
    "state": {
      "type": "string",
      "title": "State"
    },
    "zip": {
      "type": "string",
      "title": "ZIP"
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "title": "Birth Date"
    },
    "photo_url": {
      "type": "string",
      "title": "Photo URL"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "visitor",
        "member"
      ],
      "default": "active",
      "title": "Status"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "unspecified"
      ],
      "title": "Gender"
    },
    "marital_status": {
      "type": "string",
      "enum": [
        "single",
        "married",
        "divorced",
        "widowed",
        "separated"
      ],
      "title": "Marital Status"
    },
    "first_visit_date": {
      "type": "string",
      "format": "date",
      "title": "First Visit Date"
    },
    "baptism_date": {
      "type": "string",
      "format": "date",
      "title": "Baptism Date"
    },
    "membership_date": {
      "type": "string",
      "format": "date",
      "title": "Membership Date"
    },
    "family_id": {
      "type": "string",
      "title": "Family ID"
    },
    "family_role": {
      "type": "string",
      "enum": [
        "head_of_household",
        "spouse",
        "adult",
        "child",
        "unassigned",
        "other"
      ],
      "title": "Family Role"
    },
    "custom_fields": {
      "type": "object",
      "title": "Custom Fields",
      "default": {}
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "tag_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Tag IDs",
      "default": []
    },
    "volunteer_role_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Volunteer Role IDs",
      "default": []
    }
  },
  "required": [
    "first_name",
    "last_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}