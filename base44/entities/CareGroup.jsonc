{
  "name": "CareGroup",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string",
      "title": "Church ID"
    },
    "name": {
      "type": "string",
      "title": "Group Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "leader_id": {
      "type": "string",
      "title": "Leader (Person ID)"
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Member Person IDs",
      "default": []
    },
    "calendar_id": {
      "type": "string",
      "title": "Linked Calendar ID"
    },
    "color": {
      "type": "string",
      "title": "Color",
      "default": "#8b5cf6"
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.church_id": "{{user.data.church_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}