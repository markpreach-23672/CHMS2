      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendAssignmentNotification",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}